# Example .env file for minimal per-DEX tests
# Copy this file to .env and fill in your actual values

# Solana RPC endpoint - Use your Helius or other RPC provider
RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_RPC_URL=https://your-helius-rpc-url.solana.com/v0/your-api-key
HELIUS_API_KEY=your-helius-api-key

# Your wallet private key (base58 encoded)
# ⚠️ WARNING: Never commit your real private key!
# Use a test wallet with minimal funds for testing
PHANTOM_PRIVATE_KEY=your-base58-encoded-private-key-here
