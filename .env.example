# .env.example
# Copy this file to .env and fill in your values

# === Helius Configuration ===
HELIUS_API_KEY=your-helius-api-key-here

# === Wallet Configuration ===
# New mnemonic-based wallet (recommended)
MNEMONIC=your-12-or-24-word-mnemonic-phrase-here
BIP39_PASSPHRASE=optional-bip39-passphrase  # Leave empty if not using a passphrase

# Legacy private key (deprecated)
BULLX_NEO_PRIVATE_KEY_QM=your-legacy-private-key-here  # Will be removed in future

# === RPC Configuration ===
QUICKNODE_RPC_URL=optional-quicknode-rpc-url  # Optional backup RPC

# === Jito Configuration ===
JITO_AUTH_TOKEN=your-jito-auth-token-here
