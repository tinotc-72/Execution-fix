    async def _build_basic_pumpfun_transaction(self, token_mint: str) -> Optional[VersionedTransaction]:
        """
        🚨 CRITICAL FIX: Build basic Pump.fun transaction for NEW TOKENS
        
        This method ensures new tokens can ALWAYS execute by building a simple
        Pump.fun swap transaction that works immediately without Jupiter dependencies.
        
        NEW TOKENS STRATEGY:
        1. Build basic Pump.fun swap instructions manually
        2. Add compute budget and priority fees
        3. Return VersionedTransaction ready for Jito
        4. NO external APIs needed - works for any new token
        """
        try:
            logger.info(f"   🔧 BUILDING BASIC PUMP.FUN TRANSACTION for new token {token_mint[:8]}...")
            
            # Calculate lamports from SOL investment
            lamports = int(self.config.investment_amount_sol * 1e9)
            logger.info(f"   💰 Investment: {lamports:,} lamports ({self.config.investment_amount_sol} SOL)")
            
            # Import required Solana libraries for manual transaction building
            from solders.instruction import Instruction
            from solders.message import MessageV0
            from solders.transaction import VersionedTransaction
            from solders.address_lookup_table_account import AddressLookupTableAccount
            from solders.compute_budget import set_compute_unit_limit, set_compute_unit_price
            import base58
            
            # 🚨 CRITICAL: Validate token mint before conversion to prevent Base58 errors
            if not token_mint or len(token_mint) < 32:
                logger.error(f"❌ Invalid token mint: {token_mint} (too short)")
                return None
                
            # 🚨 ULTRA-AGGRESSIVE TOKENS: Skip placeholder tokens that aren't real Base58
            ultra_aggressive_tokens = [
                'AGGRESSIVE_TARGET_WALLET_BUY_',
                'AGGRESSIVE_BUY_TOKEN_',
                'AGGRESSIVE_SELL_TOKEN_', 
                'EMERGENCY_ASSUMPTION_TOKEN_',
                'FALLBACK_BUY_TOKEN_',
                'ERROR_FALLBACK_BUY_'
            ]
            
            is_placeholder = any(prefix in token_mint for prefix in ultra_aggressive_tokens)
            if is_placeholder:
                logger.warning(f"⚠️ Skipping placeholder token: {token_mint[:20]}...")
                logger.warning(f"   This is an ultra-aggressive assumption token, not a real mint")
                return None
            
            try:
                # Pump.fun program constants
                PUMP_PROGRAM_ID = Pubkey.from_string("6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P")
                PUMP_GLOBAL = Pubkey.from_string("4wTV1YmiEkRvAtNtsSGPtUrqRYQMe5SKy2uB4Jjaxnjf")  # Pump.fun global account
                PUMP_FEE_RECIPIENT = Pubkey.from_string("CebN5WGQ4jvEPvsVU4EoHEpgzq1VV9RVqPkTFTTEFqZ")  # Pump.fun fee account
                
                # Token and wallet accounts - with error handling
                token_mint_pubkey = Pubkey.from_string(token_mint)
                wallet_pubkey = self.wallet.pubkey()
            except Exception as e:
                logger.error(f"❌ Base58 conversion error for token {token_mint[:20]}...: {e}")
                logger.error(f"   This token mint is not a valid Solana address")
                return None
            
            # Get associated token account for the token
            from spl.token.instructions import get_associated_token_address
            wallet_token_account = get_associated_token_address(wallet_pubkey, token_mint_pubkey)
            
            # Build compute budget instructions (CRITICAL for new tokens)
            compute_limit_ix = set_compute_unit_limit(400_000)  # High limit for meme coins
            compute_price_ix = set_compute_unit_price(50_000)   # High priority fees (0.05 SOL in compute units)
            
            logger.info(f"   ⚡ Compute Budget: 400K units, 50K microlamports priority")
            
            # Build basic Pump.fun buy instruction data
            # This is a simplified instruction that should work for most Pump.fun tokens
            instruction_data = bytes([
                0x66, 0x06, 0x3d, 0x12, 0x01, 0x00, 0x00, 0x00,  # Pump.fun buy discriminator
            ]) + lamports.to_bytes(8, 'little') + bytes(8)  # Amount + slippage buffer
            
            # Account keys for Pump.fun buy instruction
            accounts = [
                wallet_pubkey,           # 0: Buyer (signer)
                PUMP_GLOBAL,            # 1: Global account
                PUMP_FEE_RECIPIENT,     # 2: Fee recipient
                token_mint_pubkey,      # 3: Token mint
                wallet_token_account,   # 4: Buyer's token account
                Pubkey.from_string("So11111111111111111111111111111111111111112"),  # 5: WSOL mint
                Pubkey.from_string("11111111111111111111111111111111"),  # 6: System program
                Pubkey.from_string("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"),  # 7: Token program
                Pubkey.from_string("ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL"),  # 8: Associated token program
                Pubkey.from_string("SysvarRent111111111111111111111111111111111"),  # 9: Rent sysvar
            ]
            
            # Create the Pump.fun instruction
            pump_instruction = Instruction(
                program_id=PUMP_PROGRAM_ID,
                data=instruction_data,
                accounts=[
                    {"pubkey": account, "is_signer": i == 0, "is_writable": i < 5}
                    for i, account in enumerate(accounts)
                ]
            )
            
            logger.info(f"   🎪 Built Pump.fun instruction with {len(accounts)} accounts")
            
            # Get recent blockhash
            blockhash_response = await self.rpc_client.get_latest_blockhash()
            recent_blockhash = blockhash_response.value.blockhash
            
            # Create message with all instructions
            message = MessageV0.try_compile(
                payer=wallet_pubkey,
                instructions=[compute_limit_ix, compute_price_ix, pump_instruction],
                address_lookup_table_accounts=[],  # No lookup tables needed for basic transaction
                recent_blockhash=recent_blockhash
            )
            
            # Create versioned transaction
            transaction = VersionedTransaction(message, [])  # Signatures will be added later
            
            logger.info(f"   ✅ BASIC PUMP.FUN transaction built successfully!")
            logger.info(f"   🚀 Ready for Jito submission with high priority fees")
            logger.info(f"   💎 Token: {token_mint}")
            logger.info(f"   💰 Amount: {self.config.investment_amount_sol} SOL")
            logger.info(f"   ⚡ Priority: 50K microlamports (high priority)")
            
            return transaction
            
        except Exception as e:
            logger.error(f"❌ Error building basic Pump.fun transaction: {e}")
            logger.error(f"   Traceback: {traceback.format_exc()}")
            logger.warning(f"   🔄 This token might require different DEX approach")
            return None

    async def _build_direct_dex_transaction(
        self,
        token_mint: str,
        detected_dex: str,
        extra_params: Dict[str, Any] = None
    ) -> Optional[VersionedTransaction]:
        """
        Build transaction directly using the detected DEX (fastest for new meme coins)
        
        This is the OPTIMAL approach for new tokens:
        1. No external API dependencies (faster than Jupiter)
        2. Uses the same DEX the source wallet used (perfect copy trading)
        3. Works immediately for new tokens that don't have Jupiter liquidity yet
        """
        try:
            logger.info(f"   🚀 Building DIRECT {detected_dex} transaction for {token_mint[:8]}...")
            
            # STRATEGY: Use your existing DEX executors to build transaction instructions
            # but don't execute them - just get the transaction for Jito submission
            
            dex_lower = detected_dex.lower().strip()
            
            if "pump" in dex_lower:
                # PUMP.FUN DIRECT TRANSACTION (Best for new meme coins)
                return await self._build_pumpfun_jito_transaction(token_mint, extra_params)
                
            elif "raydium" in dex_lower:
                # RAYDIUM DIRECT TRANSACTION
                return await self._build_raydium_jito_transaction(token_mint, extra_params)
                
            elif "orca" in dex_lower:
                # ORCA DIRECT TRANSACTION
                return await self._build_orca_jito_transaction(token_mint, extra_params)
                
            else:
                logger.warning(f"   ⚠️ Direct transaction building not implemented for {detected_dex}")
                logger.info(f"   🔄 Will fall back to manual transaction building...")
                return None
                
        except Exception as e:
            logger.error(f"❌ Error building direct {detected_dex} transaction: {e}")
            logger.debug(traceback.format_exc())
            return None

    async def _build_pumpfun_jito_transaction(
        self,
        token_mint: str,
        extra_params: Dict[str, Any] = None
    ) -> Optional[VersionedTransaction]:
        """
        🚀 PURE JITO + PUMP.FUN: Build transaction for direct Jito submission (NO JUPITER!)
        
        This is the FASTEST approach for new meme coins:
        1. Build Pump.fun swap instructions directly using pumpfun_copy_executor
        2. Add Jito tip instructions for bundle eligibility
        3. Send via Jito for maximum speed + MEV protection
        4. NO Jupiter dependency - works immediately for new tokens
        """
        try:
            logger.info(f"   🎪 Building PURE JITO + PUMP.FUN transaction (NO Jupiter dependency)...")
            
            # 🚨 CRITICAL: Validate token mint before Jito transaction building
            if not token_mint or len(token_mint) < 32:
                logger.error(f"❌ Invalid token mint for Jito: {token_mint} (too short)")
                return None
                
            # 🚨 ULTRA-AGGRESSIVE TOKENS: Skip placeholder tokens that aren't real Base58
            ultra_aggressive_tokens = [
                'AGGRESSIVE_TARGET_WALLET_BUY_',
                'AGGRESSIVE_BUY_TOKEN_',
                'AGGRESSIVE_SELL_TOKEN_', 
                'EMERGENCY_ASSUMPTION_TOKEN_',
                'FALLBACK_BUY_TOKEN_',
                'ERROR_FALLBACK_BUY_'
            ]
            
            is_placeholder = any(prefix in token_mint for prefix in ultra_aggressive_tokens)
            if is_placeholder:
                logger.warning(f"⚠️ Skipping Jito build for placeholder token: {token_mint[:20]}...")
                logger.warning(f"   This is an ultra-aggressive assumption token, not a real mint")
                return None
            
            try:
                # Test token mint conversion to catch Base58 errors early
                from solders.pubkey import Pubkey
                token_mint_pubkey = Pubkey.from_string(token_mint)
            except Exception as e:
                logger.error(f"❌ Base58 conversion error for Jito: {token_mint[:20]}... - {e}")
                return None
            
            # Use the native Pump.fun copy executor for direct transaction building
            from pumpfun_copy_executor import PumpFunCopyExecutor, CopyExecutorConfig
            
            # Create executor instance for transaction building
            pumpfun_config = CopyExecutorConfig(
                compute_unit_limit=400_000,  # Higher compute for Jito
                compute_unit_price=50,       # High priority fee for fast execution
                slippage_tolerance=0.30      # 30% slippage for new tokens
            )
            
            pumpfun_executor = PumpFunCopyExecutor(
                wallet_keypair=self.wallet,
                rpc_url=str(self.rpc_client._provider.endpoint_uri),  # Convert to string
                config=pumpfun_config
            )
            
            # Calculate SOL amount in lamports
            lamports = int(self.config.investment_amount_sol * 1e9)
            
            logger.info(f"   💰 Amount: {lamports:,} lamports ({self.config.investment_amount_sol} SOL)")
            logger.info(f"   💎 Token: {token_mint}")
            logger.info(f"   🎯 Building NATIVE Pump.fun transaction with Jito tip instructions...")
            
            # Build buy instruction using native Pump.fun executor
            buy_instruction = await pumpfun_executor.build_buy_instruction(
                token_mint=token_mint,
                sol_amount=lamports,
                max_slippage_bps=int(pumpfun_config.slippage_tolerance * 10000)  # Convert to basis points
            )
            
            if not buy_instruction:
                logger.warning(f"   ⚠️ Failed to build Pump.fun buy instruction")
                return None
            
            # Get recent blockhash
            recent_blockhash = (await self.rpc_client.get_latest_blockhash()).value.blockhash
            
            # Build transaction with Jito tip instruction
            instructions = [
                set_compute_unit_limit(pumpfun_config.compute_unit_limit),
                set_compute_unit_price(pumpfun_config.compute_unit_price),
                buy_instruction
            ]
            
            # Add Jito tip instruction for bundle eligibility
            try:
                from tx_builder import create_jito_tip_instruction
                tip_instruction = create_jito_tip_instruction(
                    payer=self.wallet.pubkey(),
                    tip_lamports=50_000  # 0.00005 SOL tip for bundle eligibility
                )
                instructions.append(tip_instruction)
                logger.info(f"   ✅ Added Jito tip instruction for bundle eligibility")
            except Exception as tip_error:
                logger.warning(f"   ⚠️ Failed to add tip instruction: {tip_error}")
                logger.info(f"   � Proceeding without tip (will use RPC fallback)")
            
            # Create VersionedTransaction
            from solders.message import MessageV0
            message = MessageV0.try_compile(
                payer=self.wallet.pubkey(),
                instructions=instructions,
                recent_blockhash=recent_blockhash,
                address_lookup_table_accounts=[]
            )
            
            transaction = VersionedTransaction(message, [self.wallet])
            
            logger.info(f"   ✅ PURE JITO + PUMP.FUN transaction built successfully!")
            logger.info(f"   🚀 Native Pump.fun instructions with Jito tip for bundle eligibility!")
            logger.info(f"   ⚡ Priority fees: {pumpfun_config.compute_unit_price} micro-lamports per CU")
            logger.info(f"   🎯 NO Jupiter dependency - immediate execution for brand new tokens!")
            
            return transaction
                
        except ImportError as import_error:
            logger.warning(f"   ⚠️ Native Pump.fun executor not available: {import_error}")
            logger.info(f"   🔄 Falling back to direct execution approach...")
            return None
                
        except Exception as e:
            logger.error(f"❌ Error building PURE JITO + PUMP.FUN transaction: {e}")
            logger.debug(f"   Traceback: {traceback.format_exc()}")
            return None
                
        except Exception as e:
            logger.error(f"❌ Error building Pump.fun Jito transaction: {e}")
            logger.debug(traceback.format_exc())
            return None

