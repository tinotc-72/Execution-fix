    def _get_prioritized_dex_executors(self, detected_dex: str = None):
        """Get prioritized list of your enhanced DEX executors"""
        # Prioritize based on detected DEX
        if detected_dex:
            dex_priority_map = {
                "Pump.fun": ["pumpfun"],
                "Jupiter": ["jupiter", "pumpfun"],
                "Raydium": ["raydium", "cpmm"],
                "Orca": ["orca", "clmm"],
            }
            
            priority_dexes = dex_priority_map.get(detected_dex, [])
            prioritized = []
            
            # Add priority DEXes first
            for dex_name, (buy_func, sell_func) in self.dex_executors.items():
                if dex_name in priority_dexes:
                    prioritized.append((dex_name, buy_func, sell_func))
            
            # Add remaining DEXes
            for dex_name, (buy_func, sell_func) in self.dex_executors.items():
                if dex_name not in priority_dexes:
                    prioritized.append((dex_name, buy_func, sell_func))
                    
            return prioritized
        
        # Default priority: independent DEXes first, Jupiter-dependent second
        independent_first = []
    async def _async_confirm_transaction(self, signature: str, token_mint: str, dex_name: str):
        """OFFICIAL SOLANA: Async confirmation using getSignatureStatuses (per documentation)"""
        try:
            logger.info(f"🔍 ASYNC CONFIRMATION: Checking {signature[:12]}... via {dex_name}")
            
            # Official Solana documentation: Use getSignatureStatuses for confirmation
            for attempt in range(6):  # Check 6 times over 15 seconds for faster confirmation
                await asyncio.sleep(2.5)  # Reduced wait time for copy trading speed
                
                try:
                    # Official method per Solana docs
                    from solders.signature import Signature as SolSignature
                    sig_obj = SolSignature.from_string(signature)
                    
                    # Use official getSignatureStatuses RPC method
                    status_result = await self.rpc_client.get_signature_statuses([sig_obj])
                    
                    if status_result.value and status_result.value[0]:
                        status = status_result.value[0]
                        if status.err:
                            logger.error(f"❌ CONFIRMED FAILED: {signature[:12]}... Error: {status.err}")
                            return
                        elif status.confirmation_status:
                            logger.info(f"✅ CONFIRMED SUCCESS: {signature[:12]}... Status: {status.confirmation_status}")
                            logger.info(f"   💎 Token {token_mint[:8]}... buy confirmed via {dex_name}")
                            return
                    
                    logger.info(f"⏳ PENDING: {signature[:12]}... (attempt {attempt + 1}/3)")
                    
                except Exception as check_error:
                    logger.debug(f"⚠️ Confirmation check error: {check_error}")
            
            logger.warning(f"⏰ TIMEOUT: {signature[:12]}... confirmation timed out (may still succeed)")
            
        except Exception as e:
            logger.debug(f"❌ Async confirmation error: {e}")

    async def _try_direct_rpc_execution(self, transaction_instructions: list, description: str = "Direct RPC") -> Optional[str]:
        """
        🚀 ULTRA-FAST DIRECT RPC EXECUTION - Based on Hope Latest working method
        This bypasses all Jito processing for maximum speed when needed
        """
        try:
            logger.info(f"⚡ DIRECT RPC EXECUTION: {description}")
            
            # Get recent blockhash (required for transaction)
            blockhash_resp = await self.rpc_client.get_latest_blockhash()
            if not blockhash_resp.value:
                logger.error("❌ Failed to get recent blockhash")
                return None
            
            recent_blockhash = blockhash_resp.value.blockhash
            
            # Add minimal compute budget for fast execution
            minimal_instructions = [
                set_compute_unit_limit(200_000),     # Sufficient for most trades
                set_compute_unit_price(1),           # Minimal priority fee for speed
                *transaction_instructions            # Your actual trading instructions
            ]
            
            # Build transaction with minimal overhead
            try:
                message = MessageV0.try_compile(
                    payer=self.wallet.pubkey(),
                    instructions=minimal_instructions,
                    address_lookup_table_accounts=[],
                    recent_blockhash=recent_blockhash
                )
                
                transaction = VersionedTransaction(message, [self.wallet])
                
            except Exception as compile_error:
                logger.error(f"❌ Transaction compile failed: {compile_error}")
                return None
            
            # CRITICAL: Simulate first to catch errors (like Hope Latest method)
            try:
                sim_result = await self.rpc_client.simulate_transaction(transaction)
                if sim_result.value and sim_result.value.err:
                    logger.error(f"❌ Simulation failed: {sim_result.value.err}")
                    if sim_result.value.logs:
                        for log in sim_result.value.logs[-3:]:  # Show last 3 logs
                            logger.error(f"   Log: {log}")
                    return None
                logger.debug(f"✅ Simulation passed")
            except Exception as sim_error:
                logger.warning(f"⚠️ Simulation error (proceeding anyway): {sim_error}")
            
            # DIRECT RPC SEND - Hope Latest style with minimal options
            try:
                result = await self.rpc_client.send_transaction(
                    transaction,
                    opts=TxOpts(
                        skip_preflight=True,        # Skip preflight for speed
                        max_retries=0               # No retries for fast execution
                    )
                )
                
                if not result.value:
                    logger.error("❌ Direct RPC send failed - no signature returned")
                    return None
                
                signature = str(result.value)
                logger.info(f"✅ DIRECT RPC SUCCESS: {signature[:12]}...")
                
                # Fast confirmation check (Hope Latest style)
                asyncio.create_task(self._fast_confirmation_check(signature, description))
                
                return signature
                
            except Exception as send_error:
                logger.error(f"❌ Direct RPC send error: {send_error}")
                return None
                
        except Exception as e:
            logger.error(f"❌ Direct RPC execution failed: {e}")
            return None

    async def _fast_confirmation_check(self, signature: str, description: str):
        """Fast confirmation check for direct RPC transactions - Hope Latest style"""
        try:
            # Quick confirmation loop (30 attempts = ~30 seconds max)
            for i in range(30):
                try:
                    status = await self.rpc_client.get_transaction(
                        signature, 
                        max_supported_transaction_version=0
                    )
                    if status.value:
                        if hasattr(status.value, 'meta') and status.value.meta:
                            if status.value.meta.err:
                                logger.error(f"❌ {description} FAILED: {signature[:12]}... - {status.value.meta.err}")
                                return False
                            else:
                                logger.info(f"✅ {description} CONFIRMED: {signature[:12]}...")
                                return True
                        else:
                            logger.info(f"✅ {description} CONFIRMED: {signature[:12]}...")
                            return True
                except Exception as e:
                    logger.debug(f"⚠️ Confirmation check error: {e}")
                    # Continue checking - temporary RPC errors shouldn't stop confirmation
                
                await asyncio.sleep(0.5)  # Faster checks for copy trading
            
            logger.warning(f"⏰ {description} confirmation timeout: {signature[:12]}... (may still succeed)")
            return None
            
        except Exception as e:
            logger.debug(f"❌ Fast confirmation error: {e}")
            return None

    async def _execute_copy_sell(self, token_mint: str, trade_info: Dict[str, Any], source_wallet: str):
        """JITO-FIRST PROPORTIONAL SELL: Execute proportional copy sell with Jito MEV protection"""
        try:
            if token_mint not in self.positions:
                logger.warning(f"⚠️ No position to sell for {token_mint[:8]}...")
                return
                
            logger.info(f"💸 JITO-FIRST PROPORTIONAL SELL: {token_mint[:8]}...")
            
            # Step 1: Analyze target wallet's sell percentage
            sell_percentage = await self._analyze_target_sell_percentage(trade_info, source_wallet, token_mint)
            
            if sell_percentage <= 0:
                logger.warning(f"⚠️ Could not determine target wallet sell percentage - using fallback 25%")
                sell_percentage = 0.25  # Conservative fallback
            
            logger.info(f"📊 Target wallet sold {sell_percentage:.1%} of their position")
            
            # Step 2: Calculate your proportional sell amount
            your_sell_amount = await self._calculate_proportional_sell_amount(token_mint, sell_percentage)
            
            if your_sell_amount <= 0:
                logger.warning(f"⚠️ No tokens to sell proportionally for {token_mint[:8]}...")
                return
                
            logger.info(f"🎯 PROPORTIONAL SELL: Selling {sell_percentage:.1%} of your position")
            logger.info(f"   💰 Your tokens to sell: {your_sell_amount:.6f}")
            
            # Step 3: JITO-FIRST EXECUTION with proportional sell
            success = await self._try_jito_first_sell_execution(
                token_mint, your_sell_amount, sell_percentage, source_wallet, trade_info
            )
            
            if success:
                logger.info(f"✅ JITO-FIRST PROPORTIONAL SELL COMPLETED for {token_mint[:8]}...")
                logger.info(f"   📊 Sold {sell_percentage:.1%} matching target wallet")
            else:
                logger.error(f"❌ JITO-FIRST PROPORTIONAL SELL FAILED for {token_mint[:8]}...")
            
            return success
                
        except Exception as e:
            logger.error(f"❌ Error in Jito-first proportional copy sell: {e}")
            import traceback
            logger.debug(traceback.format_exc())
            return False

    async def _get_wallet_token_balance(self, wallet_address: str, token_mint: str) -> float:
        """
        🎯 ENHANCED: Get precise current token balance for proportional calculation
        """
        try:
            # Get token account for this wallet
            from spl.token.instructions import get_associated_token_address
            
            token_account = get_associated_token_address(
                Pubkey.from_string(wallet_address),
                Pubkey.from_string(token_mint)
            )
            
            # Get account info
            account_info = await self.rpc_client.get_account_info(token_account)
            
            if account_info.value is None:
                return 0.0  # No token account = 0 balance
                
            # Parse token account data
            account_data = account_info.value.data
            if len(account_data) >= 64:
                # Token balance is stored at bytes 64-72 (8 bytes, little endian)
                balance_bytes = account_data[64:72]
                balance_raw = int.from_bytes(balance_bytes, byteorder='little')
                
                # Convert from token units (usually 6 or 9 decimals)
                # For most tokens, assume 6 decimals unless we know otherwise
                balance = balance_raw / 1e6
                
                logger.debug(f"🎯 Token balance for {wallet_address[:8]}...: {balance:.6f}")
                return balance
            
            return 0.0
            
        except Exception as e:
            logger.debug(f"❌ Error getting token balance: {e}")
            return 0.0

    async def _analyze_historical_sell_patterns(self, wallet_address: str, token_mint: str) -> float:
        """
        📊 ENHANCED: Analyze historical selling patterns to predict current sell percentage
        """
        try:
            logger.info(f"📊 Analyzing historical sell patterns for {wallet_address[:8]}...")
            
            # Get recent transactions for this wallet
            params = {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "getSignaturesForAddress",
                "params": [wallet_address, {"limit": 10}]
            }
            
            async with aiohttp.ClientSession() as session:
                async with session.post(self.env_keys.HELIUS_RPC_URL, 
                                      json=params,
                                      headers={'Content-Type': 'application/json'}) as response:
                    data = await response.json()
            
            signatures = data.get("result", [])
            sell_percentages = []
            
            # Analyze recent transactions for sell patterns
            for sig_info in signatures[:5]:  # Check last 5 transactions
                signature = sig_info.get("signature")
                if signature:
                    percentage = await self._analyze_transaction_for_sell_percentage(
                        signature, wallet_address, token_mint
                    )
                    if percentage > 0:
                        sell_percentages.append(percentage)
            
            if sell_percentages:
                # Use median sell percentage as predictor
                sell_percentages.sort()
                median_idx = len(sell_percentages) // 2
                median_percentage = sell_percentages[median_idx]
                
                logger.info(f"📊 Historical analysis: {len(sell_percentages)} sells, median {median_percentage:.1%}")
                return median_percentage
            
            return 0.0
            
        except Exception as e:
            logger.debug(f"❌ Error in historical analysis: {e}")
            return 0.0

    async def _analyze_target_sell_percentage(self, trade_info: Dict[str, Any], target_wallet: str, token_mint: str) -> float:
        """Analyze what percentage of their position the target wallet sold"""
        try:
            logger.info(f"🔍 Analyzing target wallet sell percentage...")
            
            # Method 1: Use trade_info if it contains amount data
            if trade_info and isinstance(trade_info, dict):
                token_amount = trade_info.get('token_amount', 0)
                sol_amount = trade_info.get('sol_amount', 0)
                
                if token_amount > 0:
                    logger.info(f"📊 Target sold {token_amount:.6f} tokens for {sol_amount:.6f} SOL")
                    
                    # Get target wallet's remaining balance to calculate percentage
                    total_before_sell = await self._estimate_target_wallet_total_tokens(
                        target_wallet, token_mint, token_amount
                    )
                    
                    if total_before_sell > 0:
                        percentage = token_amount / total_before_sell
                        logger.info(f"� Calculated sell percentage: {percentage:.1%}")
                        return min(percentage, 1.0)  # Cap at 100%
            
            # Method 2: Analyze transaction logs for sell patterns
            signature = trade_info.get('signature') if trade_info else None
            if signature:
                percentage = await self._analyze_transaction_for_sell_percentage(signature, target_wallet, token_mint)
                if percentage > 0:
                    return percentage
            
            # Method 3: Use heuristics based on typical selling patterns
            logger.info(f"📊 Using heuristic-based sell percentage estimation...")
            
            # Common meme coin selling patterns
            heuristic_patterns = {
                'profit_taking': 0.25,    # 25% - taking profits
                'risk_management': 0.50,  # 50% - reducing risk
                'exit': 1.0,             # 100% - full exit
                'small_trim': 0.10       # 10% - small position trim
            }
            
            # Default to profit-taking pattern for copy trading
            return heuristic_patterns['profit_taking']
            
        except Exception as e:
            logger.error(f"❌ Error analyzing target sell percentage: {e}")
            return 0.25  # Conservative 25% fallback

    async def _estimate_target_wallet_total_tokens(self, wallet_address: str, token_mint: str, tokens_sold: float) -> float:
        """Estimate target wallet's total token holdings before the sell"""
        try:
            # Get current token balance via RPC
            from solders.pubkey import Pubkey
            wallet_pubkey = Pubkey.from_string(wallet_address)
            
            # Get token accounts for this wallet
            token_accounts = await self.rpc_client.get_token_accounts_by_owner(
                wallet_pubkey, 
                {"mint": Pubkey.from_string(token_mint)},
                commitment="confirmed"
            )
            
            current_balance = 0
            if token_accounts.value:
                for account in token_accounts.value:
                    account_data = account.account.data
                    if hasattr(account_data, 'parsed'):
                        token_amount = account_data.parsed['info']['tokenAmount']
                        current_balance += float(token_amount['uiAmount'] or 0)
            
            # Total before sell = current balance + what they just sold
            total_before_sell = current_balance + tokens_sold
            
            logger.info(f"📊 Target wallet token analysis:")
            logger.info(f"   Current balance: {current_balance:.6f}")
            logger.info(f"   Just sold: {tokens_sold:.6f}")
            logger.info(f"   Total before sell: {total_before_sell:.6f}")
            
            return total_before_sell
            
        except Exception as e:
            logger.error(f"❌ Error estimating target wallet tokens: {e}")
            # Fallback: assume they sold 25% of their position
            return tokens_sold / 0.25

    async def _analyze_transaction_for_sell_percentage(self, signature: str, wallet_address: str, token_mint: str) -> float:
        """Analyze the actual transaction to determine sell percentage"""
        try:
            # Convert string signature to Signature object for Solders
            from solders.signature import Signature
            sig_obj = Signature.from_string(signature)
            
            # Get transaction details
            tx_response = await self.rpc_client.get_transaction(
                sig_obj,
                encoding="jsonParsed",
                max_supported_transaction_version=0,
                commitment="confirmed"
            )
            
            if not tx_response.value:
                return 0
                
            tx_data = tx_response.value
            
            # Analyze pre/post token balances
            meta = tx_data.meta
            if not meta:
                return 0
                
            pre_balances = meta.pre_token_balances or []
            post_balances = meta.post_token_balances or []
            
            # Find token balance changes for the target wallet
            for pre_balance in pre_balances:
                if (pre_balance.owner == wallet_address and 
                    pre_balance.mint == token_mint):
                    
                    # Find corresponding post balance
                    for post_balance in post_balances:
                        if (post_balance.owner == wallet_address and 
                            post_balance.mint == token_mint and
                            post_balance.account_index == pre_balance.account_index):
                            
                            pre_amount = float(pre_balance.ui_token_amount.ui_amount)
                            post_amount = float(post_balance.ui_token_amount.ui_amount)
                            
                            if pre_amount > post_amount:
                                tokens_sold = pre_amount - post_amount
                                sell_percentage = tokens_sold / pre_amount if pre_amount > 0 else 0
                                
                                logger.info(f"📊 Transaction analysis:")
                                logger.info(f"   Pre-sell balance: {pre_amount:.6f}")
                                logger.info(f"   Post-sell balance: {post_amount:.6f}")
                                logger.info(f"   Tokens sold: {tokens_sold:.6f}")
                                logger.info(f"   Sell percentage: {sell_percentage:.1%}")
                                
                                return sell_percentage
            
            return 0
            
        except Exception as e:
            logger.error(f"❌ Error analyzing transaction for sell percentage: {e}")
            return 0

    async def _calculate_proportional_sell_amount(self, token_mint: str, sell_percentage: float) -> float:
        """Calculate how many tokens you should sell proportionally"""
        try:
            # Get your current token balance
            your_token_balance = await self._get_your_token_balance(token_mint)
            
            if your_token_balance <= 0:
                logger.warning(f"⚠️ You have no {token_mint[:8]}... tokens to sell")
                return 0
                
            # Calculate proportional sell amount
            tokens_to_sell = your_token_balance * sell_percentage
            
            logger.info(f"📊 Proportional sell calculation:")
            logger.info(f"   Your current balance: {your_token_balance:.6f} tokens")
            logger.info(f"   Target sell percentage: {sell_percentage:.1%}")
            logger.info(f"   Your tokens to sell: {tokens_to_sell:.6f}")
            
            return tokens_to_sell
            
        except Exception as e:
            logger.error(f"❌ Error calculating proportional sell amount: {e}")
            return 0

    async def _get_your_token_balance(self, token_mint: str) -> float:
        """Get your current token balance for the specified token"""
        try:
            from solders.pubkey import Pubkey
            
            # Get token accounts for your wallet using proper commitment and encoding
            token_accounts = await self.rpc_client.get_token_accounts_by_owner(
                self.wallet_pubkey,
                {"mint": Pubkey.from_string(token_mint)},
                commitment="confirmed",
                encoding="jsonParsed"  # CRITICAL FIX: Specify encoding explicitly
            )
            
            total_balance = 0
            if token_accounts.value:
                for account in token_accounts.value:
                    # CRITICAL FIX: Handle the account data structure properly
                    account_data = account.account.data
                    if hasattr(account_data, 'parsed') and account_data.parsed:
                        info = account_data.parsed.get('info', {})
                        token_amount = info.get('tokenAmount', {})
                        ui_amount = token_amount.get('uiAmount')
                        if ui_amount is not None:
                            total_balance += float(ui_amount)
            
            logger.info(f"💰 Your {token_mint[:8]}... balance: {total_balance:.6f} tokens")
            return total_balance
            
        except Exception as e:
            logger.error(f"❌ Error getting your token balance: {e}")
            logger.debug(f"❌ Balance query traceback: {traceback.format_exc()}")
            return 0

    async def _execute_proportional_sell_transaction(self, token_mint: str, sell_amount: float, sell_percentage: float, source_wallet: str) -> bool:
        """Execute the proportional sell transaction using DEX executors"""
        try:
            # Get prioritized DEX list
            dex_executors = self._get_prioritized_dex_executors()
            
            # Try each enhanced DEX executor for proportional selling
            for dex_name, buy_func, sell_func in dex_executors:
                if not self.config.enable_dexes.get(dex_name, False):
                    continue
                    
                logger.info(f"🔄 Trying proportional sell via {dex_name.upper()}...")
                
                try:
                    # Use enhanced executor with specific amount (not sell_all)
                    result = await self._try_proportional_sell_with_dex(
                        sell_func, dex_name, token_mint, sell_amount, source_wallet
                    )
                    
                    if result.get('success'):
                        signature = result.get('signature', '')
                        actual_amount_sold = result.get('token_balance_sold', sell_amount)
                        
                        logger.info(f"✅ PROPORTIONAL SELL SUCCESS via {dex_name.upper()}")
                        logger.info(f"   💰 Sold {actual_amount_sold:.6f} tokens ({sell_percentage:.1%})")
                        logger.info(f"   🔗 Transaction: https://solscan.io/tx/{signature}")
                        
                        # Update position (reduce by proportional amount, don't delete)
                        await self._update_position_after_proportional_sell(
                            token_mint, actual_amount_sold, sell_percentage
                        )
                        
                        # Log to CSV
                        log_successful_copy_trade(
                            source_wallet, token_mint, 'proportional_sell', 
                            actual_amount_sold, dex_name, signature
                        )
                        
                        return True
                        
                    else:
                        error = result.get('error', 'Unknown error')
                        logger.warning(f"⚠️ {dex_name.upper()} proportional sell failed: {error}")
                        
                except Exception as e:
                    logger.warning(f"⚠️ {dex_name.upper()} proportional sell error: {e}")
                    continue
            
            logger.error(f"❌ All DEX executors failed for proportional sell")
            return False
            
        except Exception as e:
            logger.error(f"❌ Error executing proportional sell transaction: {e}")
            return False

    async def _try_proportional_sell_with_dex(self, sell_func, dex_name: str, token_mint: str, sell_amount: float, source_wallet: str) -> Dict[str, Any]:
        """Try proportional sell with a specific DEX executor"""
        try:
            # Check if the sell function supports amount parameter
            import inspect
            sig = inspect.signature(sell_func)
            
            if 'amount' in sig.parameters or 'sell_amount' in sig.parameters:
                # DEX supports proportional selling
                result = await sell_func(
                    self.wallet,
                    token_mint,
                    amount=sell_amount,  # Specific amount, not full position
                    slippage_tolerance=0.3,
                    max_retries=3,
                    original_wallet=source_wallet
                )
            else:
                # DEX only supports sell_all - we need to work around this
                logger.warning(f"⚠️ {dex_name} only supports sell_all, using percentage-based workaround")
                
                # For sell_all functions, we'll need to implement a workaround
                # This is a limitation of the current DEX executor design
                result = await self._sell_all_workaround_for_proportional(
                    sell_func, token_mint, sell_amount, source_wallet
                )
            
            return result
            
        except Exception as e:
            logger.error(f"❌ Error in proportional sell with {dex_name}: {e}")
            return {'success': False, 'error': str(e)}

    async def _sell_all_workaround_for_proportional(self, sell_func, token_mint: str, target_amount: float, source_wallet: str) -> Dict[str, Any]:
        """Workaround for DEX executors that only support sell_all"""
        try:
            logger.warning(f"⚠️ Using sell_all workaround for proportional selling")
            logger.warning(f"⚠️ This will sell your ENTIRE position instead of {target_amount:.6f} tokens")
            
            # ⚠️ OFFICIAL WORKAROUND: Use percentage-based selling for DEX executors that only support sell_all
            # Calculate what percentage this amount represents of total holdings
            try:
                # Get current token balance to calculate percentage
                from solders.pubkey import Pubkey
                token_accounts = await self.rpc_client.get_token_accounts_by_owner(
                    self.wallet_pubkey,
                    {"mint": Pubkey.from_string(token_mint)},
                    encoding="jsonParsed"
                )
                
                if token_accounts.value:
                    current_balance = float(token_accounts.value[0].account.data.parsed.info.tokenAmount.uiAmount or 0.0)
                    
                    if current_balance > 0:
                        sell_percentage = min(target_amount / current_balance, 1.0)  # Don't exceed 100%
                        
                        if sell_percentage < 0.1:  # Less than 10% - too small for sell_all
                            logger.warning(f"⚠️ Sell amount ({sell_percentage:.1%}) too small for sell_all workaround - skipping")
                            return {"success": False, "reason": "amount_too_small_for_sell_all"}
                        else:
                            logger.info(f"✅ Executing sell_all as {sell_percentage:.1%} approximation")
                    else:
                        logger.warning(f"⚠️ No token balance found for {token_mint[:8]}...")
                        return {"success": False, "reason": "no_token_balance"}
                else:
                    logger.warning(f"⚠️ No token account found for {token_mint[:8]}...")
                    return {"success": False, "reason": "no_token_account"}
                    
            except Exception as calc_error:
                logger.error(f"❌ Error calculating sell percentage: {calc_error}")
                # Fallback to simple sell_all
            
            result = await sell_func(
                self.wallet,
                token_mint,
                slippage_tolerance=0.3,
                max_retries=3,
                original_wallet=source_wallet
            )
            
            return result
            
        except Exception as e:
            logger.error(f"❌ Error in sell_all workaround: {e}")
            return {'success': False, 'error': str(e)}

    async def _update_position_after_proportional_sell(self, token_mint: str, amount_sold: float, sell_percentage: float):
        """Update position tracking after proportional sell"""
        try:
            if token_mint in self.positions:
                position = self.positions[token_mint]
                
                # Estimate SOL value of tokens sold (simplified)
                sol_value_sold = position.current_amount * sell_percentage
                
                # Update position amounts
                position.current_amount -= sol_value_sold
                position.our_amount -= sol_value_sold
                position.last_updated = datetime.now()
                
                logger.info(f"📊 Position updated after proportional sell:")
                logger.info(f"   Tokens sold: {amount_sold:.6f}")
                logger.info(f"   Estimated SOL value: {sol_value_sold:.6f}")
                logger.info(f"   Remaining position: {position.current_amount:.6f} SOL")
                
                # If position is too small, close it
                if position.current_amount < self.config.min_sell_threshold:
                    logger.info(f"💸 Position too small ({position.current_amount:.6f} SOL), removing from tracking")
                    del self.positions[token_mint]
                    
        except Exception as e:
            logger.error(f"❌ Error updating position after proportional sell: {e}")

    def _track_new_position(self, token_mint: str, amount_sol: float):
        """Track new position"""
        if token_mint not in self.positions:
            self.positions[token_mint] = WalletPosition(
                token_mint=token_mint,
                initial_amount=amount_sol,
                current_amount=amount_sol,
                our_amount=amount_sol
            )
        else:
            # Add to existing position
            position = self.positions[token_mint]
            position.current_amount += amount_sol
            position.our_amount += amount_sol
            position.last_updated = datetime.now()

    async def _execute_copy_sell_all(self, token_mint: str) -> Dict[str, Any]:
        """JITO-FIRST SELL ALL: Execute complete liquidation with Jito MEV protection"""
        try:
            logger.info(f"💸 JITO-FIRST LIQUIDATION: {token_mint[:8]}...")
            
            # Get current position to determine sell amount
            if token_mint not in self.positions:
                logger.warning(f"⚠️ No position found for {token_mint[:8]}... liquidation")
                return {'success': False, 'error': 'No position to liquidate'}
            
            position = self.positions[token_mint]
            
            # STEP 1: Try Jito execution if available and enabled
            if self.jito_service and self.config.use_jito:
                logger.info(f"   🚀 Attempting Jito liquidation execution...")
                
                jito_result = await self._try_jito_liquidation_transaction(token_mint)
                
                if jito_result and jito_result.success:
                    logger.info(f"✅ JITO LIQUIDATION SUCCESS via {jito_result.method}")
                    logger.info(f"   📝 Signature: {jito_result.signature[:12]}...")
                    logger.info(f"   🔗 Track: https://solscan.io/tx/{jito_result.signature}")
                    
                    # Remove position after successful liquidation
                    del self.positions[token_mint]
                    
                    # Log successful Jito liquidation
                    log_successful_copy_trade(
                        "liquidation", token_mint, 'jito_sell_all', 
                        position.current_amount, f"jito_{jito_result.method}", jito_result.signature
                    )
                    
                    return {
                        'success': True,
                        'signature': jito_result.signature,
                        'method': f'jito_{jito_result.method}',
                        'token_liquidated': token_mint
                    }
                else:
                    logger.warning(f"⚠️ Jito liquidation failed, falling back to DEX executors...")
            else:
                logger.warning(f"⚠️ Jito not available for liquidation, using DEX executors directly...")
            
            # STEP 2: Fallback to enhanced DEX executors
            logger.info(f"⚡ Falling back to DEX executors for liquidation...")
            
            # Get prioritized DEX list
            dex_executors = self._get_prioritized_dex_executors()
            
            # Try each enhanced DEX executor
            for dex_name, buy_func, sell_func in dex_executors:
                if not self.config.enable_dexes.get(dex_name, False):
                    continue
                    
                logger.info(f"🔄 Trying enhanced {dex_name.upper()} sell executor for liquidation...")
                
                try:
                    # Call your enhanced executor function
                    result = await sell_func(
                        self.wallet,
                        token_mint,
                        max_retries=3,
                        slippage_tolerance=self.config.slippage_tolerance
                    )
                    
                    if result.get('success'):
                        # Remove position after successful liquidation
                        if token_mint in self.positions:
                            del self.positions[token_mint]
                        return result
                        
                except Exception as e:
                    logger.warning(f"⚠️ Enhanced {dex_name.upper()} liquidation error: {e}")
                    continue
            
            return {
                'success': False,
                'error': 'All Jito and DEX executors failed for liquidation'
            }
            
        except Exception as e:
            return {
                'success': False,
                'error': f'Liquidation error: {str(e)}'
            }

    async def _try_jito_liquidation_transaction(self, token_mint: str) -> Optional[Dict[str, Any]]:
        """
        Build and execute complete liquidation via Jito with MEV protection
        """
        try:
            from jito_enhanced_service import JitoExecutionResult
            
            logger.info(f"🚀 Building Jito liquidation transaction for {token_mint[:8]}...")
            
            # Step 1: Build the liquidation transaction (sell all tokens)
            transaction = await self._build_liquidation_transaction(token_mint)
            
            if not transaction:
                logger.error(f"❌ Failed to build liquidation transaction for Jito execution!")
                return None
            
            # Step 2: Use higher fees for liquidation (urgent execution)
            total_fee_lamports = 150_000  # Higher fee for liquidation urgency
            priority_fee = int(total_fee_lamports * 0.7)  # 70% priority fee
            jito_tip = int(total_fee_lamports * 0.3)      # 30% Jito tip
            
            logger.info(f"   💰 Liquidation Fee Structure: {total_fee_lamports:,} lamports total")
            logger.info(f"   ⚡ Priority Fee: {priority_fee:,} lamports (70%)")
            logger.info(f"   🎯 Jito Tip: {jito_tip:,} lamports (30%)")
            
            # Step 3: Sign and execute via Jito
            logger.info(f"   🔐 Signing liquidation transaction...")
            transaction.sign([self.wallet])
            
            result = await self.jito_service.send_transaction_jito_first(
                transaction=transaction,
                priority_fee_lamports=priority_fee,
                tip_lamports=jito_tip,
                bundle_only=False  # Use normal sendTransaction for speed
            )
            
            return result
            
        except Exception as e:
            logger.error(f"❌ Error in Jito liquidation transaction: {e}")
            import traceback
            logger.debug(traceback.format_exc())
            return None

    async def _build_liquidation_transaction(self, token_mint: str):
        """
        Build complete liquidation transaction using Jupiter (sell all tokens)
        """
        try:
            logger.info(f"   🔧 Building liquidation transaction via Jupiter...")
            
            # Check if Jupiter utilities are available
            if not JUPITER_AVAILABLE:
                logger.warning(f"⚠️ Jupiter liquidation utilities not available")
                logger.error(f"❌ Cannot build Jito liquidation transaction without Jupiter utilities")
                return None
            
            # Get current token balance to liquidate completely
            from solders.pubkey import Pubkey
            
            # Get token account
            token_account = get_associated_token_address(
                self.wallet_pubkey, 
                Pubkey.from_string(token_mint)
            )
            
            # Get current token balance
            token_balance_response = await self.rpc_client.get_token_account_balance(token_account)
            if not token_balance_response.value:
                logger.error(f"❌ No token balance found for liquidation")
                return None
            
            token_balance = int(token_balance_response.value.amount)
            
            if token_balance == 0:
                logger.warning(f"⚠️ Zero token balance - nothing to liquidate")
                return None
            
            logger.info(f"   💰 Liquidating {token_balance} tokens (raw units)")
            
            # Use Jupiter to build the liquidation transaction (all tokens -> SOL)
            
            # Get Jupiter liquidation quote
            route = await get_jupiter_sell_quote(
                input_mint=token_mint,  # Token to sell
                output_mint="So11111111111111111111111111111111111111112",  # WSOL
                amount=token_balance,  # Sell ALL tokens
                slippage_bps=500  # Higher slippage for liquidation (5%)
            )
            
            if not route:
                logger.error(f"❌ No Jupiter liquidation route found")
                return None
            
            logger.info(f"   ✅ Jupiter liquidation route found!")
            logger.info(f"   📊 Liquidating {route['inAmount']} tokens for ~{int(route['outAmount'])/1e9:.6f} SOL")
            
            # Get the transaction from Jupiter
            swap_tx_b64 = await get_jupiter_sell_transaction(
                route=route,
                user_public_key=str(self.wallet_pubkey),
                wrap_unwrap_sol=True  # Auto-unwrap SOL
            )
            
            if not swap_tx_b64:
                logger.error(f"❌ Failed to get Jupiter liquidation transaction")
                return None
            
            # Convert to VersionedTransaction
            tx_bytes = base64.b64decode(swap_tx_b64)
            transaction = VersionedTransaction.from_bytes(tx_bytes)
            
            logger.info(f"   ✅ Liquidation transaction built successfully via Jupiter")
            logger.info(f"   🎯 Ready for Jito liquidation!")
            
            return transaction
            
        except Exception as e:
            logger.error(f"❌ Error building Jupiter liquidation transaction: {e}")
            logger.debug(f"   Error details: {traceback.format_exc()}")
            return None

    async def _try_direct_pumpfun_buy(self, wallet: Keypair, token_mint: str, amount_sol: float, **kwargs) -> Dict[str, Any]:
        """Direct Pump.fun buy wrapper - from your original main.py"""
        try:
            # Import your direct Pump.fun module
            from direct_pumpfun import try_direct_pumpfun_buy
            logger.info(f"🚀 Direct Pump.fun buy: {amount_sol} SOL → {token_mint[:8]}...")
            return await try_direct_pumpfun_buy(wallet, token_mint, amount_sol)
        except ImportError:
            logger.warning("⚠️ Direct Pump.fun module not found - falling back to other executors")
            return {"success": False, "signature": "", "error": "Direct Pump.fun module not available"}
        except Exception as e:
            logger.error(f"❌ Direct Pump.fun buy error: {e}")
            return {"success": False, "signature": "", "error": str(e)}

