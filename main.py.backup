    async def _try_jito_first_sell_execution(
        self, 
        token_mint: str, 
        sell_amount: float,
        sell_percentage: float,
        source_wallet: str, 
        trade_info: Dict[str, Any] = None
    ) -> Optional[bool]:
        """
        JITO-FIRST SELL EXECUTION: Execute proportional sells with Jito MEV protection
        
        This extends the Jito-first pattern to sell trades:
        1. Build optimal sell transaction using best DEX
        2. Send via Jito for MEV protection 
        3. Fallback to direct DEX execution if Jito fails
        """
        try:
            logger.info(f"🚀 JITO-FIRST SELL EXECUTION for {token_mint[:8]}...")
            logger.info(f"   💰 Selling {sell_amount:.6f} tokens ({sell_percentage:.1%} of position)")
            
            # STEP 1: Try Jito execution if available and enabled
            if self.jito_service and self.config.use_jito:
                logger.info(f"   🚀 Attempting Jito sell execution...")
                
                jito_result = await self._try_jito_sell_transaction(
                    token_mint, sell_amount, source_wallet, trade_info
                )
                
                if jito_result and jito_result.success:
                    logger.info(f"✅ JITO SELL SUCCESS via {jito_result.method}")
                    logger.info(f"   📝 Signature: {jito_result.signature[:12]}...")
                    logger.info(f"   🔗 Track: https://solscan.io/tx/{jito_result.signature}")
                    
                    # Update position after successful Jito sell
                    await self._update_position_after_proportional_sell(
                        token_mint, sell_amount, sell_percentage
                    )
                    
                    # Log successful Jito sell
                    log_successful_copy_trade(
                        source_wallet, token_mint, 'jito_proportional_sell', 
                        sell_amount, f"jito_{jito_result.method}", jito_result.signature
                    )
                    
                    # Async confirmation
                    asyncio.create_task(self._async_confirm_transaction(jito_result.signature, token_mint, "jito_sell"))
                    return True
                else:
                    logger.warning(f"⚠️ Jito sell execution failed, falling back to DEX executors...")
            else:
                logger.warning(f"⚠️ Jito not available for sell, using DEX executors directly...")
            
            # STEP 2: Fallback to direct DEX execution
            logger.info(f"⚡ Falling back to DEX executors for proportional sell...")
            
            success = await self._execute_proportional_sell_transaction(
                token_mint, sell_amount, sell_percentage, source_wallet
            )
            
            return success
            
        except Exception as e:
            logger.error(f"❌ Error in Jito-first sell execution: {e}")
            import traceback
            logger.debug(traceback.format_exc())
            return False

    async def _try_jito_sell_transaction(
        self, 
        token_mint: str, 
        sell_amount: float,
        source_wallet: str, 
        trade_info: Dict[str, Any] = None
    ) -> Optional[Dict[str, Any]]:
        """
        Build and execute sell transaction via Jito with MEV protection
        """
        try:
            from jito_enhanced_service import JitoExecutionResult
            
            logger.info(f"🚀 Building Jito sell transaction for {token_mint[:8]}...")
            
            # Step 1: Build the sell transaction using Jupiter (most reliable)
            transaction = await self._build_optimal_sell_transaction(
                token_mint, sell_amount, trade_info
            )
            
            if not transaction:
                logger.error(f"❌ Failed to build sell transaction for Jito execution!")
                return None
            
            # Step 2: Calculate fees for sell (same as buy pattern)
            total_fee_lamports = 100_000  # 0.0001 SOL total fee
            priority_fee = int(total_fee_lamports * 0.7)  # 70% priority fee
            jito_tip = int(total_fee_lamports * 0.3)      # 30% Jito tip
            
            logger.info(f"   💰 Sell Fee Structure: {total_fee_lamports:,} lamports total")
            logger.info(f"   ⚡ Priority Fee: {priority_fee:,} lamports (70%)")
            logger.info(f"   🎯 Jito Tip: {jito_tip:,} lamports (30%)")
            
            # Step 3: Sign and execute via Jito
            logger.info(f"   🔐 Signing sell transaction...")
            transaction.sign([self.wallet])
            
            result = await self.jito_service.send_transaction_jito_first(
                transaction=transaction,
                priority_fee_lamports=priority_fee,
                tip_lamports=jito_tip,
                bundle_only=False  # Use normal sendTransaction for speed
            )
            
            return result
            
        except Exception as e:
            logger.error(f"❌ Error in Jito sell transaction: {e}")
            import traceback
            logger.debug(traceback.format_exc())
            return None

    async def _build_optimal_sell_transaction(
        self, 
        token_mint: str, 
        sell_amount: float,
        trade_info: Dict[str, Any] = None
    ):
        """
        🚀 PURE JITO SELL EXECUTION: Build optimal sell transaction for maximum speed Jito execution
        
        OPTIMIZED Strategy Priority (no Jupiter for new tokens):
        1. 🎯 Pure Jito + Direct DEX instructions (FASTEST - no Jupiter dependency!)
           - Build Pump.fun/Raydium sell instructions directly
           - Send via Jito with MEV protection
           - Works immediately for any token
           
        2. ⚡ Direct high-priority sell execution (fallback)
           - Use proven sell executors with Jito-level fees
           - Still very fast, bypasses complex transaction building
           
        3. 🆘 Traditional Jupiter (LAST RESORT for established tokens only)
           - Only used when direct approaches fail AND token has established liquidity
        """
        try:
            logger.info(f"   🔧 Building PURE JITO SELL transaction...")
            logger.info(f"   💎 Token: {token_mint[:8]}...")
            logger.info(f"   💰 Amount: {sell_amount} tokens")
            
            # Get detected DEX from trade_info if available
            detected_dex = trade_info.get('dex') if trade_info else None
            
            # STRATEGY 1: Pure Jito + Direct DEX Sell Instructions (FASTEST!)
            if detected_dex:
                logger.info(f"   🚀 STRATEGY 1: PURE JITO + {detected_dex} SELL (fastest path)...")
                logger.info(f"   🎯 This approach sends sell transactions directly via Jito - MAXIMUM SPEED!")
                
                # Try building sell transaction for direct Jito submission (NO JUPITER)
                try:
                    logger.info(f"   🔧 Building {detected_dex} sell transaction for pure Jito submission...")
                    
                    # Build sell transaction using the same DEX 
                    direct_sell_transaction = await self._build_direct_dex_sell_transaction(
                        token_mint, detected_dex, sell_amount
                    )
                    
                    if direct_sell_transaction:
                        logger.info(f"   ✅ PURE JITO + {detected_dex} sell transaction built successfully!")
                        logger.info(f"   🚀 This will be sent via Jito with maximum speed + MEV protection!")
                        logger.info(f"   ⚡ NO Jupiter dependency - immediate execution!")
                        return direct_sell_transaction
                    else:
                        logger.warning(f"   ⚠️ Pure Jito sell transaction building failed, trying direct execution...")
                
                except Exception as transaction_error:
                    logger.warning(f"   ⚠️ Pure Jito sell transaction building error: {transaction_error}")
                    logger.info(f"   🔄 Falling back to direct sell execution approach...")
            
            # STRATEGY 2: Direct High-Priority Sell Execution (Fallback)
            logger.info(f"   🔄 STRATEGY 2: Direct high-priority sell execution...")
            
            # Use proven sell executors directly with Jito-level fees
            try:
                if detected_dex and "pump" in detected_dex.lower():
                    logger.info(f"   🎪 High-priority Pump.fun sell execution (Jito-level fees)...")
                    
                    success = await self._execute_high_priority_pumpfun_sell(token_mint, sell_amount)
                    if success:
                        logger.info(f"   ✅ High-priority Pump.fun sell execution successful!")
                        return "EXECUTED_DIRECTLY"  # Special return to skip other strategies
                    
                elif detected_dex and "raydium" in detected_dex.lower():
                    logger.info(f"   🌊 High-priority Raydium sell execution...")
                    
                    success = await self._execute_high_priority_raydium_sell(token_mint, sell_amount)
                    if success:
                        logger.info(f"   ✅ High-priority Raydium sell execution successful!")
                        return "EXECUTED_DIRECTLY"
                
                logger.info(f"   ⚠️ Direct sell execution didn't complete")
            
            except Exception as direct_error:
                logger.warning(f"   ⚠️ Direct sell execution error: {direct_error}")
            
            logger.warning(f"   ❌ All direct sell strategies failed - NEW TOKENS SHOULD HAVE EXECUTED BY NOW")
            logger.info(f"   🆘 LAST RESORT: Only try Jupiter for ESTABLISHED tokens with proven liquidity")
            return None
            
        except Exception as e:
            logger.warning(f"   ⚠️ Error building sell transaction: {e}")
            logger.debug(f"   Traceback: {traceback.format_exc()}")
            return None

