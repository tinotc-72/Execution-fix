                # Removed delay for instant copy trading
            
            logger.warning(f"🚨 EMERGENCY RESCAN COMPLETE: {emergency_buys_found} missed BUYs recovered!")
            
        except Exception as e:
            logger.error(f"❌ Error in emergency full rescan: {e}")

