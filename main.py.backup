    def _analyze_balance_changes(self, pre_balances: List, post_balances: List, signature: str, source_wallet: str, 
                               pre_sol_balance: float = None, post_sol_balance: float = None) -> Optional[Dict[str, Any]]:
        """OFFICIAL SOLANA METHOD: Analyze token balance changes to strictly detect BUYs vs SELLs + Profit/Loss"""
        try:
            if not (pre_balances or post_balances):
                return None
                
            logger.info(f"🎯 OFFICIAL METHOD - Analyzing balance changes for {signature[:8]}...")
            
            # Track balance changes for the SPECIFIC target wallet only
            balance_changes = {}
            
            # Analyze pre-balances - FILTER BY TARGET WALLET
            for pre_bal in pre_balances:
                owner = pre_bal.get("owner")
                if owner != source_wallet:
                    continue  # Skip if not our target wallet
                    
                mint = pre_bal.get("mint")
                if not mint:
                    continue
                    
                pre_amount = float(pre_bal.get("uiTokenAmount", {}).get("uiAmount", 0))
                balance_changes[mint] = {"pre": pre_amount, "post": 0}
                logger.debug(f"   PRE: {mint[:8]}... = {pre_amount}")
            
            # Analyze post-balances - FILTER BY TARGET WALLET
            for post_bal in post_balances:
                owner = post_bal.get("owner")
                if owner != source_wallet:
                    continue  # Skip if not our target wallet
                    
                mint = post_bal.get("mint")
                if not mint:
                    continue
                    
                post_amount = float(post_bal.get("uiTokenAmount", {}).get("uiAmount", 0))
                
                if mint in balance_changes:
                    balance_changes[mint]["post"] = post_amount
                else:
                    balance_changes[mint] = {"pre": 0, "post": post_amount}
                    
                logger.debug(f"   POST: {mint[:8]}... = {post_amount}")
            
            # OFFICIAL LOGIC: Find the token with the biggest change
            for mint, changes in balance_changes.items():
                pre_amount = changes["pre"]
                post_amount = changes["post"]
                difference = post_amount - pre_amount
                
                # Skip WSOL and system tokens
                if mint == "So11111111111111111111111111111111111111112":
                    logger.debug(f"   Skipping WSOL balance change: {difference}")
                    continue
                    
                # Significant balance change indicates a trade
                if abs(difference) > 0.001:  # Threshold for significant change
                    logger.info(f"🎯 OFFICIAL - Significant balance change detected: {mint[:8]}... = {difference:.6f}")
                    
                    # Calculate SOL amounts and profit/loss if SOL balance data available
                    sol_change = 0
                    price_per_token = 0
                    profit_loss = 0
                    
                    if pre_sol_balance is not None and post_sol_balance is not None:
                        sol_change = post_sol_balance - pre_sol_balance
                        logger.debug(f"   SOL balance change: {sol_change:.6f} SOL")
                        
                        # ENHANCED: More aggressive trade detection based on SOL changes
                        if difference > 0:  # TOKEN INCREASE = BUY
                            sol_spent = abs(sol_change) if sol_change < 0 else 0
                            price_per_token = sol_spent / difference if difference > 0 else 0
                            logger.info(f"💰 OFFICIAL BUY DETECTED: +{difference:.6f} tokens, -{sol_spent:.6f} SOL")
                            
                            trade_result = {
                                "trade_type": "buy",
                                "token_mint": mint,
                                "dex": "Official_Balance_Analysis",
                                "signature": signature,
                                "method": "balance_analysis",
                                "token_amount": difference,
                                "sol_amount": sol_spent,
                                "price_per_token": price_per_token
                            }
                            
                            logger.info(f"🎯 DEBUG: Returning BUY trade_result: {trade_result}")
                            return trade_result
                            
                        elif difference < 0:  # TOKEN DECREASE = SELL
                            sol_received = abs(sol_change) if sol_change > 0 else 0
                            tokens_sold = abs(difference)
                            price_per_token = sol_received / tokens_sold if tokens_sold > 0 else 0
                            logger.info(f"💸 OFFICIAL SELL DETECTED: -{tokens_sold:.6f} tokens, +{sol_received:.6f} SOL")
                            
                            return {
                                "trade_type": "sell",
                                "token_mint": mint,
                                "dex": "Official_Balance_Analysis", 
                                "signature": signature,
                                "method": "balance_analysis",
                                "token_amount": tokens_sold,
                                "sol_amount": sol_received,
                                "price_per_token": price_per_token
                            }
                    
                    # CRITICAL ENHANCEMENT: Detect trades based on SOL changes EVEN WITHOUT TOKEN BALANCE DATA
                    if pre_sol_balance is not None and post_sol_balance is not None:
                        sol_change = post_sol_balance - pre_sol_balance
                        
                        if sol_change < -1.0:  # Lost more than 1 SOL = Likely BUY
                            logger.info(f"🚨 CRITICAL SOL BUY DETECTED: -{abs(sol_change):.6f} SOL spent!")
                            return {
                                "trade_type": "buy",
                                "token_mint": mint,
                                "dex": "SOL_Balance_Analysis",
                                "signature": signature,
                                "method": "sol_balance_analysis",
                                "token_amount": difference if difference > 0 else 0,
                                "sol_amount": abs(sol_change),
                                "price_per_token": 0
                            }
                        elif sol_change > 1.0:  # Gained more than 1 SOL = Likely SELL
                            logger.info(f"🚨 CRITICAL SOL SELL DETECTED: +{sol_change:.6f} SOL received!")
                            return {
                                "trade_type": "sell",
                                "token_mint": mint,
                                "dex": "SOL_Balance_Analysis",
                                "signature": signature,
                                "method": "sol_balance_analysis", 
                                "token_amount": abs(difference) if difference < 0 else 0,
                                "sol_amount": sol_change,
                                "price_per_token": 0
                            }
            
            logger.info(f"🎯 OFFICIAL - No significant balance changes found for wallet {source_wallet[:8]}...")
            return None
            
        except Exception as e:
            logger.debug(f"Error in official balance analysis: {e}")
            return None

    def _analyze_instructions(self, instructions: List, signature: str) -> Optional[Dict[str, Any]]:
        """Analyze transaction instructions to detect trades"""
        try:
            logger.info(f"🔍 Analyzing {len(instructions)} instructions for {signature[:8]}...")
            
            # Look for common trading program IDs
            trading_programs = {
                "JUP4Fb2cqiRUcaTHdrPC8h2gNsA2ETXiPDD33WcGuJB": "Jupiter",
                "6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P": "Pump.fun", 
                "675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8": "Raydium",
                "whirLbMiicVdio4qvUfM5KAg6Ct8VwpYzGff3uctyCc": "Orca",
                "PhoeNiXZ8ByJGLkxNfZRnkUfjvmuYqLR89jjFHGqdXY": "Phoenix"
            }
            
            for instruction in instructions:
                program_id = instruction.get("programId", "")
                
                if program_id in trading_programs:
                    dex = trading_programs[program_id]
                    logger.info(f"🔍 Trading program detected: {dex}")
                    
                    return {
                        "trade_type": "buy",  # Default assumption
                        "token_mint": "UNKNOWN",
                        "dex": dex,
                        "signature": signature,
                        "method": "instruction_analysis"
                    }
            
            return None
            
        except Exception as e:
            logger.debug(f"Error in instruction analysis: {e}")
            return None

    async def _process_detected_trade(self, trade_info: Dict[str, Any], source_wallet: str):
        """Process detected trade with INSTANT execution and early termination"""
        start_time = time.time()
        try:
            # FIXED: Look for both 'action' (from WebSocket) and 'trade_type' (from other sources)
            trade_type = trade_info.get('action', trade_info.get('trade_type', '')).lower()
            token_mint = trade_info.get('token_mint', 'UNKNOWN')
            dex = trade_info.get('dex', 'Unknown')
            signature = trade_info.get('signature', '')
            
            logger.info(f"🎯 TRADE FOUND: {trade_type.upper()} {token_mint[:8]}... on {dex} (signature: {signature[:8]}...)")
            
            if trade_type == 'buy':
                logger.info(f"🟢 EXECUTING INSTANT COPY BUY: {token_mint[:8]}... detected on {dex}")
                
                # Execute buy immediately and CHECK RESULT
                execution_start = time.time()
                execution_success = await self._execute_copy_buy(token_mint, source_wallet, dex, None)
                execution_time = time.time() - execution_start
                
                if execution_success:
                    logger.info(f"✅ COPY BUY SUCCESS in {execution_time:.2f}s - Trade executed successfully")
                    return True  # Signal successful trade execution
                else:
                    logger.error(f"❌ COPY BUY FAILED in {execution_time:.2f}s - Trade execution failed")
                    return False  # Signal failed trade execution
                
            elif trade_type == 'sell':
                logger.info(f"🔴 COPY SELL detected: {token_mint[:8]}... on {dex}")
                
                # Execute sell if we have a position and CHECK RESULT
                execution_start = time.time()
                execution_success = await self._execute_copy_sell(token_mint, trade_info, source_wallet)
                execution_time = time.time() - execution_start
                
                if execution_success:
                    logger.info(f"✅ COPY SELL SUCCESS in {execution_time:.2f}s - Trade executed successfully")
                    return True  # Signal successful trade execution
                else:
                    logger.error(f"❌ COPY SELL FAILED in {execution_time:.2f}s - Trade execution failed")
                    return False  # Signal failed trade execution
                
            else:
                logger.warning(f"⚠️ Unknown trade type: {trade_type}")
                return False  # No trade processed
            
        except Exception as e:
            total_time = time.time() - start_time
            logger.error(f"❌ Error processing detected trade in {total_time:.2f}s: {e}")
            return False

    async def stop(self):
        """Stop the bot gracefully with position liquidation - enhanced from your original"""
        logger.info("🛑 Stopping copy trading bot...")
        self.is_running = False
        
        # Liquidate all positions before stopping (from your original)
        logger.info("💸 Liquidating all positions before shutdown...")
        await self.liquidate_all_positions()
        
        if self.rpc_client:
            await self.rpc_client.close()
            
        logger.info("✅ Bot stopped gracefully with all positions liquidated")

# Signal handling functions (from your original main.py)
def setup_signal_handlers():
    """Setup ENHANCED signal handlers for FORCE STOP"""
    signal_count = 0
    
    def signal_handler(signum, frame):
        nonlocal signal_count
        signal_count += 1
        
        print(f"\n� RECEIVED SIGNAL {signum} (attempt {signal_count}) - FORCE STOPPING...")
        
        if signal_count == 1:
            print("� FIRST SIGNAL - FORCE KILL IMMEDIATELY!")
            # SKIP GRACEFUL SHUTDOWN - IMMEDIATE TERMINATION
            try:
                if bot_instance:
                    bot_instance.is_running = False
            except:
                pass
            
            # Immediate process kill - no subprocess calls
            import os
            current_pid = os.getpid()
            print(f"🚨 KILLING PROCESS {current_pid} IMMEDIATELY!")
            os.kill(current_pid, signal.SIGKILL)
        elif signal_count == 2:
            print("🚨 Second signal - FORCE KILLING ALL PROCESSES...")
            # Force kill immediately
            if bot_instance:
                bot_instance.emergency_kill()
            else:
                import os
                os._exit(1)
        else:
            print("🔥 Third signal - NUCLEAR OPTION...")
            import os
            os._exit(1)
    
    signal.signal(signal.SIGINT, signal_handler)   # Ctrl+C
    signal.signal(signal.SIGTERM, signal_handler)  # Termination signal

async def graceful_shutdown():
    """🚨 ENHANCED graceful shutdown with FORCE STOP capabilities"""
    global bot_instance
    
    if bot_instance:
        print("� ENHANCED SHUTDOWN: Force stopping all trading operations...")
        try:
            # Set running flag to False immediately
            bot_instance.is_running = False
            
            # Use the enhanced stop method with timeout
            await asyncio.wait_for(bot_instance.stop(), timeout=10.0)
            print("✅ Enhanced shutdown completed")
            
        except asyncio.TimeoutError:
            print("⚠️ Graceful shutdown timed out - using emergency kill...")
            bot_instance.emergency_kill()
            
        except Exception as e:
            print(f"❌ Error during graceful shutdown: {e}")
            print("🚨 Using emergency kill as fallback...")
            bot_instance.emergency_kill()
            
        finally:
            # Ensure the bot stops running
            bot_instance.is_running = False
            print("🔥 Bot forced to stop running")
    else:
        print("⚠️ No bot instance found - shutting down anyway")
        import os
        os._exit(0)

