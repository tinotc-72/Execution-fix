            logger.info(f"🏆 STRATEGY #1: JITO-FIRST EXECUTION (200-500ms with MEV protection)...")
            
            if self.jito_service:
                logger.info(f"🚀 Attempting JITO bundle execution for maximum speed...")
                try:
                    jito_result = await self._try_jito_first_execution(
                        token_mint=token_mint,
                        source_wallet=source_wallet, 
                        detected_dex=detected_dex,
                        extra_params=trade_info
                    )
                    
                    if jito_result and jito_result.success:
                        execution_time = time.time() - start_time
                        logger.info(f"🏆 JITO SUCCESS in {execution_time:.2f}s! Signature: {jito_result.signature[:12]}...")
                        
                        # Update position tracking for successful Jito execution
                        self._update_position_after_buy_success(token_mint, source_wallet, "jito")
                        return True
                    else:
                        logger.warning(f"⚠️ Jito execution failed, falling back to direct executors...")
                        
                except Exception as jito_error:
                    logger.warning(f"⚠️ Jito execution error: {jito_error}")
                    logger.info(f"🔄 Falling back to direct executor execution...")
            else:
                logger.warning(f"⚠️ Jito service not available, skipping Strategy #1...")
            
            # 🎪 STRATEGY #2: IMMEDIATE WORKING DEX EXECUTION (FALLBACK)
            # Direct executor calls as backup when Jito fails
            logger.info(f"🎪 STRATEGY #2: IMMEDIATE WORKING DEX EXECUTION (Jito fallback)...")
            
            # Try working DEX executors in priority order
            working_executors = [
                ("raydium", self.dex_executors.get("raydium")),
                ("cpmm", self.dex_executors.get("cpmm")),
                ("clmm", self.dex_executors.get("clmm")),
                ("orca", self.dex_executors.get("orca")),
                ("phoenix", self.dex_executors.get("phoenix"))
            ]
            
            for dex_name, executor_pair in working_executors:
                if not executor_pair or not self.config.enable_dexes.get(dex_name, False):
                    continue
                    
                buy_func, _ = executor_pair
                logger.info(f"🚀 Trying WORKING {dex_name} executor...")
                
                try:
                    result = await buy_func(
                        self.wallet,
                        token_mint,
                        self.config.investment_amount_sol,
                        jito_service=self.jito_service,
                        slippage_tolerance=self.config.slippage_tolerance
                    )
                    
                    # Handle dict result from executor
                    if isinstance(result, dict):
                        success = result.get('success', False)
                        signature = result.get('signature', '')
                    else:
                        success = bool(result)
                        signature = ''
                    
                    if success and signature:  # Only consider success if we have a signature
                        execution_time = time.time() - start_time
                        logger.info(f"✅ {dex_name.upper()} SUCCESS in {execution_time:.2f}s!")
                        return True
                    else:
                        logger.info(f"⚠️ {dex_name} failed - trying next DEX...")
                        
                except Exception as dex_error:
                    logger.warning(f"⚠️ {dex_name} error: {dex_error}")
                    continue
            
            # 🔄 STRATEGY #3: COMPLEX EXECUTION LOGIC (FINAL FALLBACK)
            # Full analysis + prioritized execution when both Jito and direct executors fail
            logger.info(f"🔄 STRATEGY #3: COMPLEX EXECUTION LOGIC (Jito + direct executors failed)...")
            
            # CRITICAL VALIDATION: Check if this is actually a DEX program being misidentified as a token
            known_dex_programs = {
                "CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C",  # Raydium CPMM
                "JUP4Fb2cqiRUcaTHdrPC8h2gNsA2ETXiPDD33WcGuJB",  # Jupiter
                "6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P",   # Pump.fun
                "BSfD6SHZigAfDWSjzD5Q41jw8LmKwtmjskPH9XW1mrRW",  # Pump.fun router
                "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA",  # Token Program
                "11111111111111111111111111111111",  # System Program
                "ComputeBudget111111111111111111111111111111",   # Compute Budget
                "ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL",   # Associated Token Program
            }
            
            if token_mint in known_dex_programs:
                logger.error(f"🚨 CRITICAL ERROR: Trying to buy DEX program {token_mint[:8]}... instead of token!")
                logger.error(f"🔧 SWITCHING TO BALANCE-BASED ANALYSIS...")
                
                # Get the transaction signature from trade_info
                if trade_info and 'signature' in trade_info:
                    corrected_trade_info = await self._reanalyze_transaction_with_balance_data(
                        trade_info['signature'], source_wallet, 'buy'
                    )
                    
                    if corrected_trade_info:
                        token_mint = corrected_trade_info['token_mint']
                        logger.info(f"✅ CORRECTED TOKEN FOUND: {token_mint[:8]}...")
                    else:
                        logger.error(f"❌ Balance-based analysis failed - skipping trade")
                        return False
                else:
                    logger.error(f"❌ No signature available for balance analysis - skipping trade")
                    return False
            
            # Extract additional parameters from trade_info if available
            extra_params = {}
            if trade_info:
                # Pass any additional trade details to executors
                for key in ['instruction_type', 'bonding_curve', 'associated_bonding_curve', 'creator', 'signature']:
                    if key in trade_info:
                        extra_params[f'original_{key}'] = trade_info[key]
            
            # CRITICAL: Pass Jito service for MEV protection
            extra_params['jito_service'] = self.jito_service
            
            # Get prioritized execution order based on detected DEX
            prioritized_executors = self._get_prioritized_dex_executors(detected_dex)
            
            logger.info(f"🎯 PRIORITIZED EXECUTION ORDER (based on {detected_dex}):")
            for i, (dex_name, buy_func, sell_func) in enumerate(prioritized_executors):
                if self.config.enable_dexes.get(dex_name, False):
                    logger.info(f"   {i+1}. {dex_name}: {buy_func.__name__}")
            
            # Execute using prioritized order
            for dex_name, (buy_func, sell_func) in prioritized_executors:
                if not self.config.enable_dexes.get(dex_name, False):
                    logger.debug(f"⏭️ Skipping disabled DEX: {dex_name}")
                    continue
                
                logger.info(f"🎯 Trying {dex_name} buy...")
                
                try:
                    # Execute buy with enhanced retry logic
                    success = await buy_func(
                        self.wallet,
                        token_mint,
                        self.config.investment_amount_sol,
                        slippage_tolerance=self.config.slippage_tolerance,
                        **extra_params
                    )
                    
                    if success:
                        execution_time = time.time() - start_time
                        logger.info(f"✅ {dex_name} BUY SUCCESS in {execution_time:.2f}s!")
                        
                        # Update position tracking
                        self._update_position_after_buy_success(token_mint, source_wallet, dex_name)
                        return True
                    else:
                        logger.warning(f"❌ {dex_name} buy failed - trying next DEX...")
                        
                except Exception as buy_error:
                    logger.error(f"❌ {dex_name} buy error: {buy_error}")
                    continue
            
            execution_time = time.time() - start_time
            logger.error(f"❌ ALL COPY BUY ATTEMPTS FAILED after {execution_time:.2f}s")
            return False
            
        except Exception as e:
            execution_time = time.time() - start_time
            logger.error(f"❌ Copy buy execution error after {execution_time:.2f}s: {e}")
            return False

    def _update_position_after_buy_success(self, token_mint: str, source_wallet: str, dex_name: str):
        """Update position tracking after successful buy execution"""
        try:
            logger.info(f"✅ Updating position tracking for {token_mint[:8]}...")
            
            # Create or update position entry
            from dataclasses import dataclass
            
            @dataclass
            class WalletPosition:
                token_mint: str
                current_amount: float
                entry_dex: str
                source_wallet: str
                timestamp: Any
                
            if token_mint not in self.positions:
                self.positions[token_mint] = WalletPosition(
                    token_mint=token_mint,
                    current_amount=self.config.investment_amount_sol,
                    entry_dex=dex_name,
                    source_wallet=source_wallet,
                    timestamp=datetime.now(timezone.utc)
                )
                logger.info(f"📊 New position created: {self.config.investment_amount_sol} SOL in {token_mint[:8]}...")
            else:
                # Update existing position
                self.positions[token_mint].current_amount += self.config.investment_amount_sol
                logger.info(f"📊 Position updated: {self.positions[token_mint].current_amount} SOL total in {token_mint[:8]}...")
                
        except Exception as e:
            logger.error(f"❌ Error updating position: {e}")

    async def _analyze_and_copy_transaction(self, signature: str, source_wallet: str, logs: List[str]):
        """PRODUCTION-READY: Analyze transaction using validated balance-based detection and execute copy trade"""
        try:
            logger.info(f"⚡ ANALYZING transaction {signature[:8]}... from {source_wallet[:8]}...")
            
            # Use the 100% accurate balance-based detection method
            trade_result = await self._analyze_transaction_with_balance_detection(signature, source_wallet)
            
            if not trade_result:
                logger.debug(f"   ❌ No trade detected in transaction {signature[:8]}...")
                return False
            
            action = trade_result.get('action', '').lower()
            confidence = trade_result.get('confidence', 'LOW')
            token_mint = trade_result.get('token_mint')
            
            if not token_mint:
                logger.warning(f"   ❌ No token mint found in trade result")
                return False
            
            logger.info(f"🚨 TRADE DETECTED: {action.upper()} with {confidence} confidence")
            logger.info(f"   🪙 Token: {token_mint[:8]}...")
            logger.info(f"   💰 SOL Change: {trade_result.get('sol_delta', 0):+.6f} SOL")
            logger.info(f"   🎯 Reasoning: {trade_result.get('reasoning', 'Unknown')}")
            
            # Only execute copy trades for BUY actions with HIGH confidence
            if action == 'buy' and confidence == 'HIGH':
                logger.info(f"🎯 EXECUTING COPY BUY for token {token_mint[:8]}...")
                
                # Execute the copy trade
                success = await self._execute_copy_buy(
                    token_mint=token_mint,
                    source_wallet=source_wallet,
                    detected_dex="balance_detected",  # Use balance-based detection as DEX hint
                    trade_info=trade_result
                )
                
                if success:
                    logger.info(f"✅ COPY TRADE EXECUTED successfully!")
                    return True
                else:
                    logger.warning(f"❌ Copy trade execution failed")
                    return False
            
            elif action == 'sell' and confidence == 'HIGH':
                logger.info(f"📊 SELL detected - monitoring for potential exit signals")
                # Could implement sell copying logic here if needed
                return True
                
            elif action == 'swap':
                logger.info(f"🔄 SWAP detected - advanced trading pattern")
                # Could implement swap copying logic here if needed  
                return True
                
            else:
                logger.info(f"ℹ️ Trade detected but not copying (action: {action}, confidence: {confidence})")
                return True
                
        except Exception as e:
            logger.error(f"❌ Error analyzing transaction: {e}")
            import traceback
            logger.debug(traceback.format_exc())
            return False


    async def _try_jito_first_execution(
        self, 
        token_mint: str, 
        source_wallet: str, 
        detected_dex: str = None, 
        extra_params: Dict[str, Any] = None
    ) -> Optional[Dict[str, Any]]:
        """
        Try Jito-first execution following official Jito team recommendations
        
        This implements the official pattern:
        1. Build transaction using best DEX for the token
        2. Send via Jito sendTransaction (with MEV protection)
        3. Fallback to RPC if Jito fails
        
        Based on: https://docs.jito.wtf/lowlatencytxnsend/#system-overview
        """
        try:
            print(f"🚀 DEBUG: _try_jito_first_execution ENTRY")  # Force debug
            logger.info(f"🚀 Jito-first execution for {token_mint[:8]}...")
            
            from jito_enhanced_service import JitoExecutionResult
            print(f"🚀 DEBUG: JitoExecutionResult imported successfully")  # Force debug
            
            # Step 1: Build the transaction using the best available DEX
            print(f"🚀 DEBUG: About to call _build_optimal_transaction")  # Force debug
            logger.info(f"   🔧 Attempting to build transaction for Jito...")
            transaction = await self._build_optimal_transaction(
                token_mint, detected_dex, extra_params
            )
            print(f"🚀 DEBUG: _build_optimal_transaction returned: {type(transaction)}")  # Force debug
            
            # Check for special "EXECUTED_DIRECTLY" return value
            if transaction == "EXECUTED_DIRECTLY":
                logger.info(f"✅ DIRECT EXECUTION COMPLETED - Skipping Jito submission")
                # Create a success result for direct execution
                from jito_enhanced_service import JitoExecutionResult
                return JitoExecutionResult(
                    signature="direct_execution_success",
                    success=True,
                    method="direct_high_priority"
                )
            
            if not transaction:
                logger.error(f"❌ CRITICAL: Failed to build transaction for Jito execution!")
                logger.error(f"   This is why Jito is not being used - transaction building failed")
                logger.error(f"   🔄 IMMEDIATE FALLBACK: Trying direct Pump.fun execution...")
                
                # IMMEDIATE PUMP.FUN EXECUTION: If Jupiter can't build transaction, try Pump.fun directly
                try:
                    logger.info(f"🚀 EMERGENCY PUMP.FUN EXECUTION for {token_mint[:8]}...")
                    
                    # Import Pump.fun executor
                    from official_executor_wrappers import execute_pumpfun_buy
                    
                    # Execute Pump.fun buy immediately
                    pumpfun_result = await execute_pumpfun_buy(
                        wallet_keypair=self.wallet,
                        token_mint=token_mint,
                        amount_sol=self.config.investment_amount_sol,
                        original_wallet=source_wallet,
                        max_retries=1,
                        confirmation_timeout=10.0,
                        priority_fee_multiplier=5.0
                    )
                    
                    if pumpfun_result and pumpfun_result.get('success'):
                        signature = pumpfun_result.get('signature', '')
                        logger.info(f"✅ EMERGENCY PUMP.FUN SUCCESS: {signature[:12]}...")
                        
                        # Create a Jito-style result for consistency
                        from jito_enhanced_service import JitoExecutionResult
                        return JitoExecutionResult(
                            success=True,
                            signature=signature,
                            method="emergency_pumpfun",
                            execution_time=0,
                            fees_paid=0
                        )
                    else:
                        logger.error(f"❌ Emergency Pump.fun also failed: {pumpfun_result}")
                
                except Exception as emergency_error:
                    logger.error(f"❌ Emergency Pump.fun execution failed: {emergency_error}")
                
                logger.error(f"   Falling back to DEX executors instead...")
                return None
            
            # Step 2: Calculate fees following Jito 70/30 recommendation
            # For copy trading, we want fast execution so use higher fees
            total_fee_lamports = 100_000  # 0.0001 SOL total fee for meme coins
            priority_fee = int(total_fee_lamports * 0.7)  # 70% priority fee
            jito_tip = int(total_fee_lamports * 0.3)      # 30% Jito tip
            
            logger.info(f"   💰 Total Fee: {total_fee_lamports:,} lamports")
            logger.info(f"   ⚡ Priority Fee: {priority_fee:,} lamports (70%)")
            logger.info(f"   🎯 Jito Tip: {jito_tip:,} lamports (30%)")
            
            # Step 3: Sign and execute via Jito with RPC fallback
            logger.info(f"   🔐 Signing transaction...")
            transaction.sign([self.wallet])
            
            result = await self.jito_service.send_transaction_jito_first(
                transaction=transaction,
                priority_fee_lamports=priority_fee,
                tip_lamports=jito_tip,
                bundle_only=False  # Use normal sendTransaction for speed
            )
            
            # Check if Jito execution was successful
            if result and result.success:
                logger.info(f"✅ JITO EXECUTION SUCCESS: {result.signature[:12]}...")
                return result
            else:
                logger.warning(f"⚠️ Jito execution failed or returned no result")
                logger.info(f"🚀 FALLING BACK TO DIRECT RPC EXECUTION...")
                
                # Direct RPC fallback - extract instructions from the built transaction
                if transaction and hasattr(transaction, 'message') and hasattr(transaction.message, 'instructions'):
                    instructions = list(transaction.message.instructions)
                    
                    # Try direct RPC execution (Hope Latest style)
                    rpc_signature = await self._try_direct_rpc_execution(
                        instructions, 
                        f"RPC Fallback for {token_mint[:8]}..."
                    )
                    
                    if rpc_signature:
                        logger.info(f"✅ DIRECT RPC FALLBACK SUCCESS: {rpc_signature[:12]}...")
                        # Create a result object similar to Jito result
                        from jito_enhanced_service import JitoExecutionResult
                        return JitoExecutionResult(
                            success=True,
                            signature=rpc_signature,
                            method="rpc_fallback",
                            execution_time=0,
                            fees_paid=priority_fee + jito_tip
                        )
                    else:
                        logger.error(f"❌ DIRECT RPC FALLBACK ALSO FAILED")
                
                return result  # Return original result (likely failed)
            
            return result
            
        except Exception as e:
            logger.error(f"❌ Error in Jito-first execution: {e}")
            import traceback
            logger.debug(traceback.format_exc())
            return None

    async def _build_optimal_transaction(
        self, 
        token_mint: str, 
        detected_dex: str = None, 
        extra_params: Dict[str, Any] = None
    ):
        """
        🚀 PUMP.FUN FIRST EXECUTION: Build optimal transaction prioritizing native DEX builders
        
        CRITICAL PRIORITY ORDER (Pump.fun FIRST - NO Jupiter for new tokens):
        1. � PUMP.FUN NATIVE BUILDER (HIGHEST PRIORITY - 200-500ms)
           - Always try Pump.fun native transaction builder FIRST
           - Works immediately for new tokens without API dependencies
           - Uses pumpfun_copy_executor for direct instruction building
           
        2. 🚀 Other Native DEX Builders (if not Pump.fun)
           - Raydium, Orca direct transaction building
           - Still faster than Jupiter API calls
           
        3. ⚡ Direct High-Priority Execution (fallback)
           - try_pumpfun_buy with 10x priority fees
           - Proven executors for guaranteed execution
           
        4. 🚫 Jupiter ONLY as absolute last resort (for established tokens only)
        """
        try:
            logger.info(f"   🔧 Building PUMP.FUN FIRST transaction for maximum speed...")
            logger.info(f"   🏪 Detected DEX: {detected_dex}")
            logger.info(f"   💎 Token: {token_mint[:8]}...")
            
            # 🚀 STRATEGY 1: PUMP.FUN NATIVE BUILDER FIRST (HIGHEST PRIORITY!)
            if detected_dex == "pumpfun" or detected_dex is None:
                logger.info(f"   🎪 STRATEGY 1: PUMP.FUN NATIVE BUILDER (200-500ms execution)...")
                logger.info(f"   🚀 Prioritizing native Pump.fun transaction building - NO Jupiter dependency!")
                
                try:
                    logger.info(f"   🔧 Building NATIVE Pump.fun transaction for direct Jito submission...")
                    
                    # Build transaction using native Pump.fun executor (NO JUPITER!)
                    pumpfun_transaction = await self._build_pumpfun_jito_transaction(token_mint, extra_params)
                    
                    if pumpfun_transaction:
                        logger.info(f"   ✅ PUMP.FUN NATIVE transaction built successfully!")
                        logger.info(f"   🚀 Ready for Jito submission with maximum speed + MEV protection!")
                        logger.info(f"   ⚡ NO Jupiter dependency - immediate execution for brand new tokens!")
                        return pumpfun_transaction
                    else:
                        logger.warning(f"   ⚠️ Pump.fun native transaction building failed, trying direct execution...")
                
                except Exception as pumpfun_error:
                    logger.warning(f"   ⚠️ Pump.fun native transaction building error: {pumpfun_error}")
                    logger.info(f"   🔄 Falling back to direct Pump.fun execution...")
                
                # STRATEGY 1B: Direct Pump.fun Execution (Still avoiding Jupiter)
                logger.info(f"   🎪 STRATEGY 1B: Direct Pump.fun execution with high priority fees...")
                
                try:
                    success = await self._execute_high_priority_pumpfun_buy(token_mint)
                    if success:
                        logger.info(f"   ✅ Direct Pump.fun execution successful!")
                        return "EXECUTED_DIRECTLY"
                    else:
                        logger.warning(f"   ⚠️ Direct Pump.fun execution failed")
                
                except Exception as direct_pumpfun_error:
                    logger.warning(f"   ⚠️ Direct Pump.fun execution error: {direct_pumpfun_error}")
            
            # STRATEGY 2: Other Native DEX Instructions (if detected DEX is not Pump.fun)
            elif detected_dex and detected_dex != "pumpfun":
                logger.info(f"   🚀 STRATEGY 2: NATIVE {detected_dex.upper()} BUILDER...")
                logger.info(f"   🎯 Building direct {detected_dex} transaction - NO Jupiter dependency!")
                
                try:
                    # Build transaction using the detected DEX native builder
                    direct_transaction = await self._build_direct_dex_transaction(
                        token_mint, detected_dex, extra_params
                    )
                    
                    if direct_transaction:
                        logger.info(f"   ✅ NATIVE {detected_dex.upper()} transaction built successfully!")
                        return direct_transaction
                    else:
                        logger.warning(f"   ⚠️ Native {detected_dex} transaction building failed...")
                
                except Exception as native_dex_error:
                    logger.warning(f"   ⚠️ Native {detected_dex} transaction building error: {native_dex_error}")
                
                # Fallback to direct execution for this DEX
                try:
                    if "raydium" in detected_dex.lower():
                        success = await self._execute_high_priority_raydium_buy(token_mint)
                        if success:
                            logger.info(f"   ✅ Direct {detected_dex} execution successful!")
                            return "EXECUTED_DIRECTLY"
                
                except Exception as direct_dex_error:
                    logger.warning(f"   ⚠️ Direct {detected_dex} execution error: {direct_dex_error}")
            
            # STRATEGY 3: Emergency Pump.fun Execution (for brand new tokens)
            logger.info(f"   🚨 STRATEGY 3: Emergency PUMP.FUN execution for new tokens...")
            logger.info(f"   💡 New tokens require immediate Pump.fun execution - NO Jupiter first!")
            
            # 🎪 ALWAYS try Pump.fun first for new tokens (most meme coins are here)
            logger.info(f"   🎪 IMMEDIATE Pump.fun execution (primary for new tokens)...")
            success = await self._execute_immediate_pumpfun_buy(token_mint)
            if success:
                logger.info(f"   ✅ IMMEDIATE Pump.fun execution successful!")
                return "EXECUTED_DIRECTLY"
            
            # Only try other DEXs if Pump.fun fails
            logger.info(f"   ⚡ Pump.fun failed, trying other immediate executors...")
            success = await self._execute_immediate_jupiter_buy(token_mint)
            if success:
                logger.info(f"   ✅ IMMEDIATE Jupiter execution successful!")
                return "EXECUTED_DIRECTLY"
                
            logger.warning(f"   ❌ All immediate execution strategies failed - new tokens should have executed via proven direct executors")
            logger.info(f"   💡 🚫 NO Jupiter for new tokens initially - only as absolute last resort")
            return None

        except Exception as e:
            print(f"🚀 DEBUG: FATAL EXCEPTION in _build_optimal_transaction: {e}")  # Force debug
            print(f"🚀 DEBUG: Exception type: {type(e)}")  # Force debug
            print(f"🚀 DEBUG: Traceback: {traceback.format_exc()}")  # Force debug
            logger.warning(f"   ⚠️ Error building transaction: {e}")
            logger.debug(f"   Traceback: {traceback.format_exc()}")
            # Try a simpler approach if transaction building fails
            try:
                logger.info(f"   🔄 Falling back to manual transaction building...")
                # For now, return None to use the DEX executor fallback
                # In the future, this could build direct DEX transactions
                return None
                
            except Exception as fallback_error:
                logger.error(f"❌ Error in fallback transaction building: {fallback_error}")
                return None

    async def _execute_immediate_pumpfun_buy(self, token_mint: str) -> bool:
        """IMMEDIATE EXECUTION: Bypass all complex logic and execute Pump.fun buy NOW"""
        try:
            logger.info(f"   🚀 IMMEDIATE PUMP.FUN BUY: {token_mint[:8]}...")
            
            # Import the actual working executor - CORRECT FUNCTION NAME
            from official_executor_wrappers import try_pumpfun_buy
            
            result = await try_pumpfun_buy(
                wallet_keypair=self.wallet,
                token_mint=token_mint,
                amount_sol=self.config.investment_amount_sol,
                max_retries=1,
                confirmation_timeout=10.0,
                priority_fee_multiplier=5.0,
                slippage_tolerance=0.30,  # 30% FIXED: Use decimal
                original_wallet="immediate_copy_trade"
            )
            
            if result and result.get('success'):
                signature = result.get('signature', '')
                logger.info(f"   ✅ IMMEDIATE PUMP.FUN SUCCESS: {signature[:12]}...")
                
                # Track the position
                self._track_new_position(token_mint, self.config.investment_amount_sol)
                
                # Log the successful trade
                log_successful_copy_trade(
                    "immediate_execution", token_mint, 'buy',
                    self.config.investment_amount_sol, "immediate_pumpfun", signature
                )
                
                return True
            else:
